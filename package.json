{
  "name": "windows-overlay-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "os": [
    "win32"
  ],
  "description": "A Windows-only floating desktop assistant overlay.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build-server": "tsc server.ts --outDir dist-electron --module esnext --target es2020",
    "preview": "vite preview",
    "start": "node dist-electron/server.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "dotenv": "^17.4.2",
    "electron": "latest",
    "express": "^4.18.2",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "vite-plugin-electron": "latest",
    "vite-plugin-electron-renderer": "latest",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/ws": "^8.18.1",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=20"
  }
}
